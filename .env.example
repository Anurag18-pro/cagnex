DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
# Local-only role bootstrap. Keep false/unset in hosted environments.
ALLOW_ROLE_REGISTRATION=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=keep-this-server-side-only
SUPABASE_STORAGE_BUCKET=cagnex-documents
# Transactional email provider used for password-reset OTP delivery.
RESEND_API_KEY=re_your_server_only_key
RESEND_FROM_EMAIL=CAGNEX Security <security@your-verified-domain.com>
